# Replace with your PostgreSQL connection. No database is created automatically.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=5
DATABASE_CONNECT_TIMEOUT=5
DATABASE_COMMAND_TIMEOUT=10

# Required for the API. Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this value stable across restarts and identical across API instances.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=900
AUTH_RATE_WINDOW_SECONDS=60
AUTH_IP_LIMIT=60
AUTH_IDENTITY_LIMIT=10

# Provisional local defaults; API and worker must share the same persistent directory.
PDF_STORAGE_DIR=data/pdfs
UPLOAD_MAX_BYTES=20971520
UPLOAD_TIMEOUT_SECONDS=120
PDF_MAX_PAGES=500
PDF_MAX_CHUNKS=10000
OCR_ENGINE=tesseract
TOKENIZER_NAME=cl100k_base
TESSERACT_COMMAND=tesseract
# On Windows, use an absolute path if Tesseract is not in PATH.
# TESSERACT_COMMAND=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSERACT_DATA_DIR=D:/path/to/tessdata
OCR_LANGUAGES=vie+eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=120
OCR_MIN_CONFIDENCE=60
PDF_MAX_RENDER_PIXELS=25000000
PDF_MAX_TEXT_CHARS=5000000
CHUNK_MIN_TOKENS=100
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=50
CHUNK_MAX_REPAIR_ROUNDS=2
PROCESSING_CONFIG_VERSION=1
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=2
WORKER_MAX_MEMORY_MB=1024
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_DEADLINE_SECONDS=900
SOURCE_COMPLETED_RETENTION_SECONDS=86400
SOURCE_FAILED_RETENTION_SECONDS=604800
ORPHAN_GRACE_SECONDS=3600
# Uses AUTH_RATE_WINDOW_SECONDS to share the existing counter cleanup horizon.
RETRY_OWNER_LIMIT=10
